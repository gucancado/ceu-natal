# Geocodificação
GEONAMES_USERNAME=gucancado
NOMINATIM_USER_AGENT=ceu-natal-mcp/2.0
# Intervalo mínimo entre chamadas ao Nominatim (a política do OSM exige >= 1 s)
NOMINATIM_MIN_INTERVAL_S=1.0
# Teto de chamadas simultâneas aos provedores e espera máxima por uma vaga (s)
GEOCODER_MAX_CONCORRENTES=4
GEOCODER_ESPERA_MAX_S=3.0

# Caminho do cache persistente do geocoder. Em Docker fica num volume
# nomeado para sobreviver a redeploys; localmente (sem volume) usar /tmp.
GEOCODER_CACHE_PATH=/var/cache/ceu-natal/geocode-cache.json

# Autenticação MCP (só header `Authorization: Bearer`) — se vazio, libera tudo
MCP_API_KEY=
# Hosts aceitos no /mcp (anti-DNS rebinding), separados por vírgula; vazio = sem validação
MCP_ALLOWED_HOSTS=

# Servidor
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_SERVER_NAME=ceu-natal
MCP_SERVER_VERSION=2.1.0

# Limite de taxa (chamadas de tool por minuto; 0 desliga a camada)
RATE_LIMIT_SESSION_PER_MIN=30
RATE_LIMIT_GLOBAL_PER_MIN=600

# /mapa-rapido (formulário do site): pedidos por minuto por IP e no total
RATE_LIMIT_MAPA_RAPIDO_IP_PER_MIN=6
RATE_LIMIT_MAPA_RAPIDO_GLOBAL_PER_MIN=120

# URLs públicas (a landing troca de domínio só por env)
PUBLIC_SITE_URL=https://github.com/gucancado/ceu-natal
PUBLIC_MCP_URL=https://astrologia-mcp.gustavocancado.com.br
# Origens aceitas pelo CORS do /mapa-rapido (vírgula); vazio = só PUBLIC_SITE_URL
CORS_ORIGINS=
